// Cloudflare Workers: the Next.js app built by OpenNext, in two environments (cloudflare/DEPLOY.md):
//  - dev  (`--env dev`): Worker eliteflow-dev on dev.eliteflow-ai.com, its own D1 and R2. Every push to main deploys it
//    (.github/workflows/deploy.yml).
//  - production (top level): Worker eliteflow on eliteflow-ai.com. A published GitHub release deploys it.
// By hand: `npm run cf:deploy:dev` / `npm run cf:deploy`. Bindings are not inherited by env.dev, so each is listed twice.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// cloudflare/worker.ts wraps OpenNext's generated .open-next/worker.js (fetch) and adds the Cron Trigger handler.
	"main": "cloudflare/worker.ts",
	"name": "eliteflow",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "eliteflow" }],
	// Production: the live site on D1 (switched from Vercel + Supabase on 2026-11-23, cloudflare/CUTOVER.md).
	"routes": [
		{ "pattern": "eliteflow-ai.com", "custom_domain": true },
		{ "pattern": "www.eliteflow-ai.com", "custom_domain": true }
	],
	"vars": {
		"DATA_BACKEND": "d1",
		"NEXT_PUBLIC_APP_URL": "https://eliteflow-ai.com"
	},
	// The database (schema: cloudflare/d1/, generated by scripts/d1-schema.ts). Read by the app when DATA_BACKEND=d1
	// (cloudflare/d1/RUNNING.md).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eliteflow-db",
			"database_id": "e0d30416-8ced-4c5d-a754-ed6852327111",
			"migrations_dir": "cloudflare/d1"
		}
	],
	// Files of the D1 build (Supabase Storage before): keys "<bucket>/<path>", read by src/lib/d1/blobs.ts.
	"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "eliteflow-blobs" }],
	// Cron Triggers (UTC), run by cloudflare/worker.ts through /api/cron with CRON_SECRET (src/lib/cf-scheduled.ts):
	// the daily run vercel.json had, and every 5 minutes the AI-job / LINE-notification drain (?task=jobs).
	"triggers": { "crons": ["0 0 * * *", "*/5 * * * *"] },
	"env": {
		"dev": {
			"name": "eliteflow-dev",
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "eliteflow-dev" }],
			"routes": [{ "pattern": "dev.eliteflow-ai.com", "custom_domain": true }],
			"vars": {
				"DATA_BACKEND": "d1",
				"NEXT_PUBLIC_APP_URL": "https://dev.eliteflow-ai.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "eliteflow-dev-db",
					"database_id": "aa97f70b-256b-43dd-bdc9-0f8141150ec4",
					"migrations_dir": "cloudflare/d1"
				}
			],
			"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "eliteflow-blobs-dev" }],
			// No crons on dev: it holds a copy of the real data, and scheduled jobs would message real customers.
			"triggers": { "crons": [] }
		}
	}
}
