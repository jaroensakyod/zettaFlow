// Cloudflare Workers (branch cloudflare-trial): the Next.js app built by OpenNext. Deployed as a trial to
// eliteflow.<account>.workers.dev; the live site is still on Vercel. Build and deploy with `npm run cf:deploy`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "eliteflow",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "eliteflow" }],
	// The new database (schema: cloudflare/d1/, generated by scripts/d1-schema.ts). Not read by the app yet.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eliteflow-db",
			"database_id": "e0d30416-8ced-4c5d-a754-ed6852327111",
			"migrations_dir": "cloudflare/d1"
		}
	]
}
