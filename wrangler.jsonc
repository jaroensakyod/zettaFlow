// Cloudflare Workers (branch cloudflare-trial): the Next.js app built by OpenNext. Deployed as a trial to
// eliteflow.<account>.workers.dev; the live site is still on Vercel. Build and deploy with `npm run cf:deploy`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// cloudflare/worker.ts wraps OpenNext's generated .open-next/worker.js (fetch) and adds the Cron Trigger handler.
	"main": "cloudflare/worker.ts",
	"name": "eliteflow",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "eliteflow" }],
	// The new database (schema: cloudflare/d1/, generated by scripts/d1-schema.ts). Read by the app when DATA_BACKEND=d1
	// (cloudflare/d1/RUNNING.md).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eliteflow-db",
			"database_id": "e0d30416-8ced-4c5d-a754-ed6852327111",
			"migrations_dir": "cloudflare/d1"
		}
	],
	// Files of the D1 build (Supabase Storage before): keys "<bucket>/<path>", read by src/lib/d1/blobs.ts. The bucket
	// must exist before a deploy: `wrangler r2 bucket create eliteflow-blobs`.
	"r2_buckets": [{ "binding": "BLOBS", "bucket_name": "eliteflow-blobs" }],
	// Cron Triggers (UTC), run by cloudflare/worker.ts through /api/cron with CRON_SECRET (src/lib/cf-scheduled.ts):
	// the daily run vercel.json had, and every 5 minutes the AI-job / LINE-notification drain (?task=jobs).
	"triggers": { "crons": ["0 0 * * *", "*/5 * * * *"] }
}
