# Vercel: set these in Project Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Never enable demo for a deployment. Vercel also blocks demo at runtime.
ELITEFLOW_DEMO_MODE=false
# Optional: ZettaFlow AI (น้องโฟลว์, Data Inbox, form drafting) / LINE
# Google Gemini is used when GEMINI_API_KEY is set (key from aistudio.google.com); OpenAI is the fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional stronger model for the OCR+ add-on, e.g. gemini-3.5-flash
GEMINI_OCR_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# A random secret for /api/cron, also configured automatically by Vercel.
CRON_SECRET=
# Comma-separated emails of ZettaFlow platform operators who confirm subscription payments.
PLATFORM_ADMIN_EMAILS=
