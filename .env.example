# Local mode only binds to loopback. Production requires Firebase and HTTPS.
AUTH_MODE=local
PORT=3000
DATA_FILE=.data/zettaflow.sqlite
# Production: AUTH_MODE=firebase, NODE_ENV=production, HOST=0.0.0.0
# Set Google Application Default Credentials on the server, never in public/.
FIREBASE_PROJECT_ID=elitflow-38bc4
FIREBASE_WEB_API_KEY=
FIREBASE_STORAGE_BUCKET=elitflow-38bc4.firebasestorage.app
PUBLIC_ORIGIN=http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
